<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Como configurar sua chave do Gemini localmente:
  1. Copie este arquivo para Morph/Morph/Secrets.plist
  2. Cole sua chave da API dentro de <string></string> abaixo
  (O arquivo Morph/Morph/Secrets.plist é ignorado pelo Git.)
-->
<plist version="1.0">
<dict>
	<key>GEMINI_API_KEY</key>
	<string></string>
</dict>
</plist>
